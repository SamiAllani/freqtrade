# Optional local overrides for `docker compose` interpolation (Task 4).
# Runtime secrets and ftctl-rendered args live in `.env.generated`
# (produced by `ftctl render compose`, git-ignored, loaded via `env_file`).
# Copy this file to `.env` next to the compose files only if you want to
# change ports or defaults; a fresh clone works without it.
#
#   cp deploy/compose/.env.example deploy/compose/.env
#
# NOTE: FREQTRADE_TAG / FREQTRADE_ARGS below are *interpolation* defaults for
# `docker compose config` on a fresh clone. The rendered .env.generated is
# used as container env (env_file), NOT for build-arg interpolation, so for
# image builds with a non-default tag export the rendered value first:
#   set -a; source deploy/compose/.env.generated; set +a

# Freqtrade image variant: stable | stable_freqai | stable_freqaitorch
FREQTRADE_TAG=stable
# Rendered command fragment: "--strategy <Name> [--freqaimodel <Model>]"
FREQTRADE_ARGS=--strategy AiSignalStrategy

# Service URLs / ports (all bound to 127.0.0.1, see docker-compose.yml)
INFERENCE_URL=http://inference:8000
FT_API_URL=http://freqtrade:8080
FT_API_PORT=8080
INFERENCE_PORT=8000
PROM_PORT=9090
GRAFANA_PORT=3000

# mcp-server profile: yes enables pause_trading/force_exit tools (Task 7)
MCP_ALLOW_WRITE=no

# Freqtrade exporter poll interval in seconds (Task 9)
EXPORTER_POLL_INTERVAL_S=15

# Local timezone inside containers
TZ=UTC

# Grafana dev login (local stack only)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
