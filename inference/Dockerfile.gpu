# GPU inference gateway image: CUDA runtime + torch.
# Requires the NVIDIA Container Toolkit on the host:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up
# Build with the repo root as context:
#   docker build -f inference/Dockerfile.gpu .
FROM nvidia/cuda:12.1.1-runtime-ubuntu22.04

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODELS_DIR=/models \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /srv

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3.11 python3-pip \
  && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY common/ ./common/
COPY inference/app/ ./inference/app/

RUN pip install --no-cache-dir ".[gateway,gpu]"

VOLUME ["/models"]
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python3 -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz')"

CMD ["uvicorn", "inference.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
